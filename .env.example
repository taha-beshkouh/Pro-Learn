# Django reads this file only when LOAD_LOCAL_ENV=1 is exported by the process.
# Local development defaults are built into settings; every value below is a
# runtime setting and production must supply all non-optional values securely.

# DJANGO_DEBUG=false is the explicit production-mode signal.
DJANGO_DEBUG=false

# Required in production. Do not commit real secrets or credentials.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Optional. Supply comma-separated full origins (including https://) only when
# the deployment needs trusted origins beyond Django's same-origin check.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production defaults to secure cookies and rejects false. This explicit value
# documents the HTTPS deployment contract.
DJANGO_SECURE_COOKIES=true

# Keep both false until the deployment provider's forwarded-proto behavior is
# confirmed. When Runflare is proven to overwrite X-Forwarded-Proto correctly,
# enable proxy trust before enabling Django's HTTPS redirect.
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_SECURE_SSL_REDIRECT=false

# Optional runtime overrides. Defaults are already defined in settings.
LOGIN_THROTTLE_RATE=10/min
REGISTRATION_THROTTLE_RATE=5/hour
